{
  "name": "embrapa-dashboard-frontend",
  "private": true,
  "version": "1.94.0",
  "//engines": "CI and the Dockerfile build stage both read the Node major from /.nvmrc; keep the three in step. A newer local Node is what broke localStorage in the test env (see vitest.setup.js).",
  "engines": {
    "node": "^24"
  },
  "type": "module",
  "description": "Embrapa Produtos Agrícolas dashboard — React SPA (design-system UI in src/ui/) over the Python BFF REST API; analytical charts in Plotly.js.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/data src/charts src/ui",
    "test": "vitest run --coverage",
    "test:fast": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "maplibre-gl": "^6.10.0",
    "plotly.js": "^4.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
